# YarFix Environment Configuration

# Database: Neon Postgres connection string
# If left empty or unset, YarFix will automatically and safely persist leads
# to the local server storage at data/leads.json (real server disk persistence).
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Administrator Secret Key
# Used to view and export early access leads via /admin or /api/admin/leads
ADMIN_SECRET=yarfix_admin_secret_2026

# Optional App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
